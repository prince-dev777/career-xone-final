{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(blog|blog\\.html|gallery|gallery\\.html|study-material|study-material\\.html)",
      "destination": "/",
      "permanent": false
    }
  ],
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/(admin-login|admin|register|user-login|contact|contacts|admission|admissions|testseries|scholarship|scholarships|users|jobs|job)(.*)", "destination": "/server.js" }
  ]
}
